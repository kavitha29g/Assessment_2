DELIMITER //

CREATE FUNCTION calculate_bill(p_units INT)
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    DECLARE bill DECIMAL(10,2);

    IF p_units <= 100 THEN
        SET bill = p_units * 2;

    ELSEIF p_units <= 200 THEN
        SET bill = (100 * 2) + ((p_units - 100) * 3);

    ELSE
        SET bill = (100 * 2)
                 + (100 * 3)
                 + ((p_units - 200) * 5);
    END IF;

    RETURN bill;
END //

DELIMITER ;
